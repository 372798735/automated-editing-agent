{
  "workspace": "workspace",
  "log_level": "INFO",
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30.0,
    "target_min_sec": 25.0,
    "target_max_sec": 45.0,
    "clip_min_sec": 2.0,
    "clip_max_sec": 6.0,
    "max_clips": 12,
    "min_clips": 5,
    "opening_sec": 3.0,
    "transition": "",
